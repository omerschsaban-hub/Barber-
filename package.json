  "engines": {"node": ">=22 <23", "npm": ">=10"},
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "test:e2e": "playwright test",
    "test:deep": "npm run agent:preflight && npm run test:unit && npm run test:e2e",
