# Fabrient deployment configuration source of truth
#
# Keep secrets here locally only (never commit a real copy of this file).
# The deployment sync layer should distribute only the fields required by each service.
# Render backend: <= 10 runtime variables.
# Vercel frontend: <= 10 runtime variables; normally only 1-3.
# GitHub CI: no production secrets required by default.

# ---------- Core backend ----------
DATABASE_URL=postgresql://user:password@localhost:5432/fabrient?sslmode=require
AUTH_SECRET=replace-with-at-least-32-random-bytes
OPENAI_API_KEY=
DATA_FLYWHEEL_RUN_TOKEN=

# ---------- Bundled external credentials ----------
# JSON values are parsed only by the server-side config loader.
# Never expose these through NEXT_PUBLIC_* variables.
GMAIL_OAUTH_JSON={"client_id":"","client_secret":"","refresh_token":""}
REVENUECAT_CONFIG={"secret_api_key":"","webhook_auth":"","webhook_signing_secret":""}

# ---------- Public/runtime configuration ----------
GMAIL_SENDER=omerschaban@gmail.com
FABRIENT_WEB_ORIGIN=http://localhost:3000
FABRIENT_ALLOWED_ORIGINS=http://localhost:3000
FABRIENT_MCP_OAUTH_ISSUER=http://localhost:8001
FABRIENT_MCP_RESOURCE_URL=http://localhost:8001/mcp
FABRIENT_API_URL=http://localhost:8000
FABRIENT_MCP_URL=http://localhost:8001

# ---------- Defaults; do not manually duplicate across platforms ----------
ENVIRONMENT=development
DB_POOL_MIN=1
DB_POOL_MAX=8
OPENAI_MODEL=gpt-5.6
FLYWHEEL_ENABLE_PRODUCTION=false
